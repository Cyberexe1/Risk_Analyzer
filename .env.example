# FraudShield configuration. Copy to .env and fill in.
#
#   copy .env.example .env       (Windows)
#   cp .env.example .env         (macOS / Linux)
#
# .env is gitignored. .env.example is committed and must never contain a real
# secret.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# Shared API key guarding every endpoint.
#
# LEAVING THIS BLANK MAKES THE SERVICE COMPLETELY OPEN. The backend prints a
# warning at startup when it is unset. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# This is a single shared secret, not per-user auth. There is no identity, no
# roles and no rate limiting yet -- see docs/ARCHITECTURE.md section 4.
FRAUDSHIELD_API_KEY=

# Where model.json, calibrator.json and feature_spec.json live.
FRAUDSHIELD_ARTIFACTS=ml/artifacts

# Rows of history replayed into the entity store at boot, so device/IP/velocity
# counters are warm. TRAIN SPLIT ONLY -- warming from validation or test would
# leak the evaluation period into serving state. Set 0 for a cold start.
FRAUDSHIELD_WARM_ROWS=40000

# Decision thresholds. The review threshold is an OPERATIONS parameter -- it is
# set by how many analysts you employ, not by model quality. See
# docs/EVALUATION.md section 5.
FRAUDSHIELD_REVIEW_T=5
FRAUDSHIELD_BLOCK_T=70

# Comma-separated CORS allow-list. Never use "*": this service returns fraud
# reason codes, and a wildcard lets any site read them.
FRAUDSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Frontend  (web/.env -- Vite only reads VITE_* prefixed vars)
# ---------------------------------------------------------------------------

VITE_API_BASE=http://localhost:8000

# WARNING: anything with a VITE_ prefix is compiled into the JavaScript bundle
# and is readable by anyone who opens devtools. This is NOT a secret. It exists
# so the local demo can talk to the local backend.
#
# In production the browser must never hold the backend key. Put a session-
# authenticated server between them, or implement the JWT flow in
# docs/ARCHITECTURE.md section 4 and drop the shared key entirely.
VITE_API_KEY=
