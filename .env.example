# FraudShield configuration. Copy to .env and fill in.
#
#   copy .env.example .env       (Windows)
#   cp .env.example .env         (macOS / Linux)
#
# .env is gitignored. .env.example is committed and must never contain a real
# secret.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# Shared API key guarding every endpoint.
#
# LEAVING THIS BLANK MAKES THE SERVICE COMPLETELY OPEN. The backend prints a
# warning at startup when it is unset. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# This is a single shared secret, not per-user auth. There is no identity, no
# roles and no rate limiting yet -- see docs/ARCHITECTURE.md section 4.
FRAUDSHIELD_API_KEY=

# Where model.json, calibrator.json and feature_spec.json live.
FRAUDSHIELD_ARTIFACTS=ml/artifacts

# Rows of history replayed into the entity store at boot, so device/IP/velocity
# counters are warm. TRAIN SPLIT ONLY -- warming from validation or test would
# leak the evaluation period into serving state. Set 0 for a cold start.
FRAUDSHIELD_WARM_ROWS=40000

# Decision thresholds. The review threshold is an OPERATIONS parameter -- it is
# set by how many analysts you employ, not by model quality. See
# docs/EVALUATION.md section 5.
FRAUDSHIELD_REVIEW_T=5
FRAUDSHIELD_BLOCK_T=70

# Comma-separated CORS allow-list. Never use "*": this service returns fraud
# reason codes, and a wildcard lets any site read them. Credentials are enabled
# (for the refresh cookie), which browsers refuse alongside a wildcard anyway.
FRAUDSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# User authentication
# ---------------------------------------------------------------------------

# Signing key for JWT access tokens. If unset, an ephemeral key is generated at
# startup: every restart invalidates all sessions, and multiple uvicorn workers
# will reject each other's tokens. Set it for anything beyond a single-process
# demo. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FRAUDSHIELD_JWT_SECRET=

# Send the refresh cookie only over HTTPS. MUST be true in production. False by
# default because localhost is plain HTTP and a Secure cookie would never be sent.
FRAUDSHIELD_COOKIE_SECURE=false

# HMAC key for IP and card fingerprints. Raw IPs and card numbers are never
# stored -- only HMAC-SHA256(value, pepper) -- so counters and reuse detection
# work without holding the underlying data.
#
# CHANGING THIS INVALIDATES EVERY EXISTING FINGERPRINT. Entity counters and
# instrument-reuse history reset, so device/IP/card linkage starts from scratch.
# If unset, an ephemeral pepper is generated per process and the backend warns.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FRAUDSHIELD_IP_PEPPER=

# Comma-separated peer addresses whose X-Forwarded-For header may be trusted.
# Leave EMPTY unless there is a real reverse proxy in front: honouring that header
# from an untrusted peer lets any caller claim any IP, which defeats every
# IP-based control in the risk engine.
FRAUDSHIELD_TRUSTED_PROXIES=

# "memory" (default) or "dynamodb".
#
# memory   -- ALL ACCOUNTS ARE LOST ON RESTART. Fine for a demo.
# dynamodb -- persists to a real AWS table. This creates billable resources, so
#             it is opt-in. Create the table first (see DynamoUserStore's
#             docstring in backend.py) and scope the IAM policy to that table.
FRAUDSHIELD_USERS_BACKEND=memory
FRAUDSHIELD_USERS_TABLE=fraudshield
FRAUDSHIELD_AWS_REGION=ap-south-1

# Seed an admin and an analyst account at startup, so the console is reachable.
# There is no API path to a privileged role, so this (or scripts/grant_role.py) is
# the only way to create staff. LOCAL DEVELOPMENT ONLY -- set 0 before exposing
# the service anywhere.
FRAUDSHIELD_DEV_SEED_STAFF=0

# Staff credentials. Passwords are read from here rather than written into source:
# a literal in a tracked file is one `git push` from being public, and the admin
# account controls the decision thresholds for all future traffic.
#
# Leave the passwords BLANK to have random ones generated and printed at startup.
# Existing accounts are never overwritten -- change a password by deleting the
# user from the table first.
FRAUDSHIELD_ADMIN_EMAIL=admin@fraudshield.local
FRAUDSHIELD_ADMIN_PASSWORD=
FRAUDSHIELD_ANALYST_EMAIL=analyst@fraudshield.local
FRAUDSHIELD_ANALYST_PASSWORD=

# ---------------------------------------------------------------------------
# AWS credentials  (only read when FRAUDSHIELD_USERS_BACKEND=dynamodb)
# ---------------------------------------------------------------------------
#
# Standard names are preferred; boto3 finds these on its own.
#
# SECURITY: long-lived IAM user keys are the riskiest AWS credential type. They
# do not expire, they are easy to leak, and a leak is a standing breach. Prefer
# an EC2 instance role, ECS task role or IRSA in any real deployment and leave
# these blank. If you must use static keys:
#   - scope the IAM policy to GetItem/PutItem/UpdateItem/Query/DeleteItem on the
#     one table, nothing wider
#   - rotate them on a schedule
#   - rotate immediately if they have ever been pasted anywhere shared
#
# NEVER give these a VITE_ prefix. Vite compiles every VITE_* variable into the
# browser bundle, which would publish your AWS credentials to every visitor.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Frontend  (web/.env -- Vite only reads VITE_* prefixed vars)
# ---------------------------------------------------------------------------

VITE_API_BASE=http://localhost:8000

# WARNING: anything with a VITE_ prefix is compiled into the JavaScript bundle
# and is readable by anyone who opens devtools. This is NOT a secret. It exists
# so the local demo can talk to the local backend.
#
# In production the browser must never hold the backend key. Put a session-
# authenticated server between them, or implement the JWT flow in
# docs/ARCHITECTURE.md section 4 and drop the shared key entirely.
VITE_API_KEY=

# --- payment webhook ingestion ---
#
# Shared secret for HMAC-SHA256 verification of inbound payment events at
# POST /v1/webhooks/payment.
#
# The endpoint is public and unauthenticated -- the signature IS the
# authentication. If this is unset the endpoint refuses every request with 503
# rather than accepting unverified events, because an unverified webhook lets
# anyone who finds the URL inject transactions into the risk engine.
#
# With a real provider this is the webhook secret from their dashboard. For the
# local simulator it just has to match what scripts/emit_webhook.py reads, so
# generate any high-entropy value:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FRAUDSHIELD_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Payment provider
# ---------------------------------------------------------------------------

# Which gateway sits behind checkout: "simulated" (default) or "razorpay".
#
# This switch is EXPLICIT on purpose. Razorpay is never enabled just because the
# keys below happen to be present -- a credential left in a shell profile must not
# silently redirect live checkout traffic at a payment provider.
#
# simulated -- the built-in stand-in gateway. No external call, no account, no
#              money. Settlement resolves immediately, server-side, AFTER scoring.
# razorpay  -- creates a real Razorpay order via their SDK. Requires a Razorpay
#              BUSINESS ACCOUNT for Test Mode credentials, plus `pip install
#              razorpay` (deliberately not in requirements-serve.txt).
#
# If this is set to razorpay without both keys below, the service logs a DEGRADED
# warning, reports it on /health, and keeps serving the simulator. It does not
# fail every checkout, and it does not pretend Razorpay is live.
FRAUDSHIELD_PAYMENT_PROVIDER=simulated

# Razorpay Test Mode credentials. Vendor-standard names, following the same
# convention as AWS_ACCESS_KEY_ID above.
#
# HONEST STATUS: this project has NO Razorpay account, so the adapter has never
# been run against the live API. It is written against the documented SDK surface
# and tested against a mocked client. Leave these blank unless you have your own
# account -- filling them in with anything invented will simply fail at
# order.create, which the adapter reports as unresolved rather than successful.
#
# Test Mode keys start with rzp_test_. NEVER put a live rzp_live_ key here, and
# NEVER give any of these a VITE_ prefix -- the key secret would be compiled into
# the browser bundle.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay's dashboard name for the webhook signing secret. Accepted as a FALLBACK
# for FRAUDSHIELD_WEBHOOK_SECRET above, which still wins where both are set. This
# is an alternative way to supply the same secret, not a way to skip verification:
# with neither set, the webhook endpoint still refuses every request with 503.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Analyst email notifications
# ---------------------------------------------------------------------------
#
# Alerts an analyst when something needs a human: MANUAL_REVIEW, BLOCK, a newly
# flagged address, or a held promotion claim.
#
# FraudShield NEVER emails a customer about a risk decision. Not a warning, not
# an "unusual activity" notice, nothing. Telling a payer they were flagged tells
# a card tester exactly what to rotate, and telling an innocent customer they are
# under suspicion is a harm the product has no right to inflict. These addresses
# are staff addresses only.

# "console" (default) or "smtp".
#
# console -- renders the full alert to stdout and records it in memory. Sends
#            nothing. This is the default and it needs no credentials, so a fresh
#            clone, CI and the demo all work with zero configuration.
# smtp    -- actually transmits, using Python's standard smtplib.
#
# Explicit on purpose: SMTP is never enabled just because a host happens to be
# set below, because a stray value in a shell profile must not start mailing an
# unknown relay.
#
# If this is "smtp" but the host or sender is missing, the service logs a DEGRADED
# warning, reports it on /health, and falls back to console. It never crashes, and
# it never pretends an email was delivered.
FRAUDSHIELD_EMAIL_PROVIDER=console

# Envelope sender for alerts. Required for SMTP mode.
FRAUDSHIELD_ALERT_FROM=

# Who receives alerts. Comma or semicolon separated; whitespace is trimmed,
# duplicates are removed, and an entry without an "@" is dropped with a warning
# at startup rather than failing the others.
#
# STAFF ADDRESSES ONLY. Leave blank and alerts are rendered to the console and
# delivered to nobody -- /health reports alerts_enabled: false rather than
# implying anyone was told.
FRAUDSHIELD_ALERT_RECIPIENTS=

# SMTP transport. Only read when FRAUDSHIELD_EMAIL_PROVIDER=smtp.
FRAUDSHIELD_SMTP_HOST=
FRAUDSHIELD_SMTP_PORT=587

# Optional. An internal relay on a trusted network legitimately accepts
# unauthenticated mail, so these are not required -- leaving them blank is valid
# and does not trigger the degraded fallback.
FRAUDSHIELD_SMTP_USERNAME=

# For Gmail and most hosted providers this is an APP PASSWORD, not your account
# password. Generate one at https://myaccount.google.com/apppasswords with 2FA
# enabled.
#
# This value is never logged, never printed at startup, never returned by any API
# endpoint, never written to an audit record, and never rendered in a traceback
# (SMTPEmailProvider.__repr__ redacts it deliberately). .env is gitignored.
#
# NEVER give this a VITE_ prefix -- Vite compiles every VITE_* variable into the
# browser bundle, which would publish your mail credential to every visitor.
FRAUDSHIELD_SMTP_PASSWORD=

# STARTTLS with certificate and hostname verification. Leave true. Setting this
# false sends your credential and every alert in clear text.
FRAUDSHIELD_SMTP_USE_TLS=true

# Base URL used to build the "investigate in the console" link inside an alert.
# Blank is safe: the alert then says the URL is unconfigured rather than emitting
# a broken link.
FRAUDSHIELD_CONSOLE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# demo fraud attack  (POST /v1/admin/demo/fraud-attack)
# ---------------------------------------------------------------------------

# Enables the admin-only synthetic-attack trigger. OFF unless set explicitly.
#
# The trigger generates eight suspicious payment attempts on one synthetic
# account, one device and one address, sixty seconds apart, and sends every one of
# them through the real scoring, persistence, audit and notification pipeline. It
# assigns no risk score and no decision -- the engine decides.
#
# Why this is off by default: the transactions it creates are indistinguishable
# from real ones to the analyst reading the queue. An operator investigating a
# genuine incident must never find synthetic evidence mixed into it, so consent has
# to be explicit rather than inferred.
#
# There is a SECOND, independent gate that is not configurable here: the endpoint
# refuses to run unless the payment provider is the simulator, both as requested
# and as resolved. That check is deliberately separate, because "the simulator is
# active" is a normal state for this project and is not consent to inject traffic.
#
# Alerts follow whatever FRAUDSHIELD_EMAIL_PROVIDER is set to above. With the
# default console provider the alerts are rendered and delivered to nobody; set
# provider=smtp with recipients to have the demo actually email an analyst.
FRAUDSHIELD_DEMO_MODE=false
