# FraudShield configuration. Copy to .env and fill in.
#
#   copy .env.example .env       (Windows)
#   cp .env.example .env         (macOS / Linux)
#
# .env is gitignored. .env.example is committed and must never contain a real
# secret.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# Shared API key guarding every endpoint.
#
# LEAVING THIS BLANK MAKES THE SERVICE COMPLETELY OPEN. The backend prints a
# warning at startup when it is unset. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# This is a single shared secret, not per-user auth. There is no identity, no
# roles and no rate limiting yet -- see docs/ARCHITECTURE.md section 4.
FRAUDSHIELD_API_KEY=

# Where model.json, calibrator.json and feature_spec.json live.
FRAUDSHIELD_ARTIFACTS=ml/artifacts

# Rows of history replayed into the entity store at boot, so device/IP/velocity
# counters are warm. TRAIN SPLIT ONLY -- warming from validation or test would
# leak the evaluation period into serving state. Set 0 for a cold start.
FRAUDSHIELD_WARM_ROWS=40000

# Decision thresholds. The review threshold is an OPERATIONS parameter -- it is
# set by how many analysts you employ, not by model quality. See
# docs/EVALUATION.md section 5.
FRAUDSHIELD_REVIEW_T=5
FRAUDSHIELD_BLOCK_T=70

# Comma-separated CORS allow-list. Never use "*": this service returns fraud
# reason codes, and a wildcard lets any site read them. Credentials are enabled
# (for the refresh cookie), which browsers refuse alongside a wildcard anyway.
FRAUDSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# User authentication
# ---------------------------------------------------------------------------

# Signing key for JWT access tokens. If unset, an ephemeral key is generated at
# startup: every restart invalidates all sessions, and multiple uvicorn workers
# will reject each other's tokens. Set it for anything beyond a single-process
# demo. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FRAUDSHIELD_JWT_SECRET=

# Send the refresh cookie only over HTTPS. MUST be true in production. False by
# default because localhost is plain HTTP and a Secure cookie would never be sent.
FRAUDSHIELD_COOKIE_SECURE=false

# HMAC key for IP and card fingerprints. Raw IPs and card numbers are never
# stored -- only HMAC-SHA256(value, pepper) -- so counters and reuse detection
# work without holding the underlying data.
#
# CHANGING THIS INVALIDATES EVERY EXISTING FINGERPRINT. Entity counters and
# instrument-reuse history reset, so device/IP/card linkage starts from scratch.
# If unset, an ephemeral pepper is generated per process and the backend warns.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FRAUDSHIELD_IP_PEPPER=

# Comma-separated peer addresses whose X-Forwarded-For header may be trusted.
# Leave EMPTY unless there is a real reverse proxy in front: honouring that header
# from an untrusted peer lets any caller claim any IP, which defeats every
# IP-based control in the risk engine.
FRAUDSHIELD_TRUSTED_PROXIES=

# "memory" (default) or "dynamodb".
#
# memory   -- ALL ACCOUNTS ARE LOST ON RESTART. Fine for a demo.
# dynamodb -- persists to a real AWS table. This creates billable resources, so
#             it is opt-in. Create the table first (see DynamoUserStore's
#             docstring in backend.py) and scope the IAM policy to that table.
FRAUDSHIELD_USERS_BACKEND=memory
FRAUDSHIELD_USERS_TABLE=fraudshield
FRAUDSHIELD_AWS_REGION=ap-south-1

# Seed an admin and an analyst account at startup, so the console is reachable.
# There is no API path to a privileged role, so this (or scripts/grant_role.py) is
# the only way to create staff. LOCAL DEVELOPMENT ONLY -- set 0 before exposing
# the service anywhere.
FRAUDSHIELD_DEV_SEED_STAFF=0

# Staff credentials. Passwords are read from here rather than written into source:
# a literal in a tracked file is one `git push` from being public, and the admin
# account controls the decision thresholds for all future traffic.
#
# Leave the passwords BLANK to have random ones generated and printed at startup.
# Existing accounts are never overwritten -- change a password by deleting the
# user from the table first.
FRAUDSHIELD_ADMIN_EMAIL=admin@fraudshield.local
FRAUDSHIELD_ADMIN_PASSWORD=
FRAUDSHIELD_ANALYST_EMAIL=analyst@fraudshield.local
FRAUDSHIELD_ANALYST_PASSWORD=

# ---------------------------------------------------------------------------
# AWS credentials  (only read when FRAUDSHIELD_USERS_BACKEND=dynamodb)
# ---------------------------------------------------------------------------
#
# Standard names are preferred; boto3 finds these on its own.
#
# SECURITY: long-lived IAM user keys are the riskiest AWS credential type. They
# do not expire, they are easy to leak, and a leak is a standing breach. Prefer
# an EC2 instance role, ECS task role or IRSA in any real deployment and leave
# these blank. If you must use static keys:
#   - scope the IAM policy to GetItem/PutItem/UpdateItem/Query/DeleteItem on the
#     one table, nothing wider
#   - rotate them on a schedule
#   - rotate immediately if they have ever been pasted anywhere shared
#
# NEVER give these a VITE_ prefix. Vite compiles every VITE_* variable into the
# browser bundle, which would publish your AWS credentials to every visitor.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Frontend  (web/.env -- Vite only reads VITE_* prefixed vars)
# ---------------------------------------------------------------------------

VITE_API_BASE=http://localhost:8000

# WARNING: anything with a VITE_ prefix is compiled into the JavaScript bundle
# and is readable by anyone who opens devtools. This is NOT a secret. It exists
# so the local demo can talk to the local backend.
#
# In production the browser must never hold the backend key. Put a session-
# authenticated server between them, or implement the JWT flow in
# docs/ARCHITECTURE.md section 4 and drop the shared key entirely.
VITE_API_KEY=

# --- payment webhook ingestion ---
#
# Shared secret for HMAC-SHA256 verification of inbound payment events at
# POST /v1/webhooks/payment.
#
# The endpoint is public and unauthenticated -- the signature IS the
# authentication. If this is unset the endpoint refuses every request with 503
# rather than accepting unverified events, because an unverified webhook lets
# anyone who finds the URL inject transactions into the risk engine.
#
# With a real provider this is the webhook secret from their dashboard. For the
# local simulator it just has to match what scripts/emit_webhook.py reads, so
# generate any high-entropy value:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FRAUDSHIELD_WEBHOOK_SECRET=
